# IDE
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Agent/tooling scratch output — plans and run artifacts are session state,
# not source. Never part of a release tag (MR-18).
.artifacts/
**/.artifacts/

# Local release staging (the APK/checksums themselves are GitHub Release
# assets, not repo content — MR-18 "release assets are never committed").
/releases/

# Local secrets and signing material (MR-12, MR-18)
*.jks
*.p12
*.pem
.env
.env.*
!.env.example

# Never commit personal media, real archives or private diagnostics (MR-18)
fixtures/private/
*.mediareminder.zip
/diagnostics/
