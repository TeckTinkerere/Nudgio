<?xml version="1.0" encoding="utf-8"?>
<!--
  What the preview card shows when the linked media has no thumbnail — audio
  without cover art, a text note, or a video whose frame could not be
  decoded. A tinted gradient plus the kind glyph, rather than a broken image
  well or a hole where the card was.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#335EDBC8"
        android:endColor="#1E2A26"
        android:type="linear" />
</shape>
