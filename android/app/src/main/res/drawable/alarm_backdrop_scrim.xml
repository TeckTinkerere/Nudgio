<?xml version="1.0" encoding="utf-8"?>
<!--
  Legibility scrim over the reminder's own artwork. Darkest at the top and
  bottom, where the clock and the action buttons sit, and lightest across the
  middle so the picture is still a picture (MR-13 contrast floor, without
  flattening the artwork into a grey rectangle the way a single flat 60 %
  black did).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#D90E1513"
        android:centerColor="#730E1513"
        android:endColor="#F20E1513"
        android:type="linear" />
</shape>
