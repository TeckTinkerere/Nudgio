<?xml version="1.0" encoding="utf-8"?>
<!--
  MR-10 "Sharing and privacy": "Completed private exports shared through
  another app use FileProvider with read-only temporary URI permission."
  `files-path name="backups"` matches `BackupExporter`'s export directory
  (`filesDir/backups`) exactly — this file grants no other path, so a share
  intent can never expose anything outside that one folder. Internal storage,
  not `external-files-path`: external app storage is readable by other apps
  on Android 8-9 and over USB (SEC-01).

  `files-path name="media"` mirrors `MediaStorage.mediaDir()`
  (`filesDir/media/`) for the Library's "Export selected" action — same
  read-only, single-folder grant shape as the backups entry above.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="backups" path="backups/" />
    <files-path name="media" path="media/" />
</paths>
