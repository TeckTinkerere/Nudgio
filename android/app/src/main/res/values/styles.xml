<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      MR-04: Material 3 provides the interaction foundation. The RN design
      system owns the brand for everything React renders; these color
      attributes exist so native Material widgets (system dialogs, popup
      menus, AlarmActivity) carry the same brand instead of Material's
      default baseline palette. Values live in res/values/colors.xml.
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:editTextStyle">@style/ResetEditText</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorError">@color/brand_error</item>
    </style>

    <style name="ResetEditText" parent="@android:style/Widget.EditText">
        <item name="android:padding">0dp</item>
    </style>

    <!--
      AlarmActivity is always dark, whatever the system theme: it is an
      immersive surface drawn over arbitrary media artwork, the same reasoning
      src/features/library/MediaViewerChrome.tsx gives for the media viewers.
    -->
    <style name="Theme.AppTheme.Alarm" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/brand_dark_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/brand_dark_primary</item>
        <item name="colorOnPrimary">@color/brand_dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/brand_dark_surface_container_high</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark_on_surface</item>
        <item name="colorSurface">@color/brand_dark_surface</item>
        <item name="colorOnSurface">@color/brand_dark_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/brand_dark_on_surface_variant</item>
        <item name="colorOutline">@color/brand_dark_outline</item>
        <item name="colorError">@color/brand_dark_error</item>
    </style>

    <!--
      Alarm action sizes mirror src/design-system/tokens: alarmActionPreferredHeight
      (64) for the primary action, alarmActionMinHeight (56) for the others,
      radius.alarmAction (20) for all three.
    -->
    <style name="AlarmAction" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="AlarmAction.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="AlarmAction.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/brand_dark_on_surface</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/brand_dark_outline</item>
        <item name="iconTint">@color/brand_dark_on_surface</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>
</resources>
