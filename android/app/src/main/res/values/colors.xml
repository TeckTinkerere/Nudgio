<?xml version="1.0" encoding="utf-8"?>
<!--
  Native mirror of src/design-system/tokens/palette.ts, which is the source of
  truth. Keep these hex values in sync with it.

  brand_light_* and brand_dark_* are fixed. brand_* follows the system
  day/night setting (overridden in values-night/colors.xml).
-->
<resources>
    <color name="brand_light_primary">#2D4DB5</color>
    <color name="brand_light_on_primary">#FFFFFF</color>
    <color name="brand_light_primary_container">#E7ECFB</color>
    <color name="brand_light_on_primary_container">#2D4DB5</color>
    <color name="brand_light_secondary">#E9B58E</color>
    <color name="brand_light_on_secondary">#56321C</color>
    <color name="brand_light_secondary_container">#F8E9DC</color>
    <color name="brand_light_on_secondary_container">#70401F</color>
    <color name="brand_light_surface">#F7F4EE</color>
    <color name="brand_light_surface_container">#FFFEFA</color>
    <color name="brand_light_on_surface">#202638</color>
    <color name="brand_light_on_surface_variant">#5F6675</color>
    <color name="brand_light_outline">#767E90</color>
    <color name="brand_light_error">#B42332</color>

    <color name="brand_dark_primary">#BAC8FF</color>
    <color name="brand_dark_on_primary">#172654</color>
    <color name="brand_dark_primary_container">#26314E</color>
    <color name="brand_dark_on_primary_container">#BAC8FF</color>
    <color name="brand_dark_secondary">#F1BE98</color>
    <color name="brand_dark_on_secondary">#56321C</color>
    <color name="brand_dark_secondary_container">#392A21</color>
    <color name="brand_dark_on_secondary_container">#FFD2AF</color>
    <color name="brand_dark_surface">#11141D</color>
    <color name="brand_dark_surface_container">#1D2230</color>
    <color name="brand_dark_surface_container_high">#262B38</color>
    <color name="brand_dark_on_surface">#F3F1EC</color>
    <color name="brand_dark_on_surface_variant">#BCC2D0</color>
    <color name="brand_dark_outline">#858FA5</color>
    <color name="brand_dark_error">#FFB5BE</color>
    <!-- 0.64 black: the dark-mode scrim token. -->
    <color name="brand_dark_scrim">#A3000000</color>
    <!-- Midnight overlays preserve readability over arbitrary user artwork. -->
    <color name="brand_dark_artwork_scrim_start">#8011141D</color>
    <color name="brand_dark_artwork_scrim_center">#B311141D</color>
    <color name="brand_dark_artwork_scrim_end">#FF11141D</color>
    <color name="brand_dark_hero_outline">#33BAC8FF</color>

    <!--
      Launcher icon. Deliberately bound to the brand_light_* tokens rather
      than the day/night brand_* ones: a launcher icon is drawn once by the
      system and must not follow the app's theme. The Android 13+ themed
      variant is what adapts, and it is tinted from the wallpaper, so its own
      colour only has to be opaque.

      Flipping the plate and the mark here is all it takes to invert the icon
      to cream-on-cobalt; cobalt-on-cream was chosen to match the logo and the
      website header.
    -->
    <color name="ic_launcher_plate">@color/brand_light_surface</color>
    <color name="ic_launcher_mark">@color/brand_light_primary</color>
    <color name="ic_launcher_accent">@color/brand_light_secondary</color>
    <color name="ic_launcher_mono">#FFFFFF</color>

    <color name="brand_primary">@color/brand_light_primary</color>
    <color name="brand_on_primary">@color/brand_light_on_primary</color>
    <color name="brand_primary_container">@color/brand_light_primary_container</color>
    <color name="brand_on_primary_container">@color/brand_light_on_primary_container</color>
    <color name="brand_secondary">@color/brand_light_secondary</color>
    <color name="brand_on_secondary">@color/brand_light_on_secondary</color>
    <color name="brand_secondary_container">@color/brand_light_secondary_container</color>
    <color name="brand_on_secondary_container">@color/brand_light_on_secondary_container</color>
    <color name="brand_surface">@color/brand_light_surface</color>
    <color name="brand_surface_container">@color/brand_light_surface_container</color>
    <color name="brand_on_surface">@color/brand_light_on_surface</color>
    <color name="brand_on_surface_variant">@color/brand_light_on_surface_variant</color>
    <color name="brand_outline">@color/brand_light_outline</color>
    <color name="brand_error">@color/brand_light_error</color>
</resources>
