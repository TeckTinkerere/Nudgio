<?xml version="1.0" encoding="utf-8"?>
<!--
  MR-06 "Full-screen alarm activity".

  Rebuilt around the media. The previous version opened with an 80sp clock
  and gave the user's own photo/video a 136dp rounded tile — so the screen
  that exists to bring a personal moment back read as a generic alarm clock
  with a thumbnail attached. (It was worse in practice: the artwork never
  loaded at all, because the activity resolved `thumbnailPath` as an absolute
  path when the column only stores a file name. See AlarmActivity.showArtwork.)

  Now the media is the screen: full-bleed behind, and sharp in a large frame
  the content is built around. The time drops to a single small line under
  the words — at the instant an alarm wakes you, what time it is is the least
  surprising fact on the screen, and the system status bar already says it.
  The repeat summary ("Every day at 8:00 PM") is gone entirely: the recurrence
  rule is configuration, and nobody reads configuration while an alarm rings.

  Always dark (Theme.AppTheme.Alarm) and colored from the native brand mirror
  in res/values/colors.xml. Plain Views + Material components; no Compose
  dependency exists in this project.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_dark_surface">

    <!-- The reminder's own artwork, full-bleed and dimmed, so the alarm looks like the thing it is about. Decorative. -->
    <ImageView
        android:id="@+id/alarm_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/alarm_background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/alarm_scrim_gradient"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/alarm_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <!-- Brand + sound control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notification"
                app:tint="@color/brand_dark_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/brand_dark_on_surface_variant"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_silence_button"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:text="@string/alarm_silence_sound"
                android:textColor="@color/brand_dark_on_surface"
                android:textSize="13sp"
                app:backgroundTint="@color/brand_dark_surface_container_high"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_alarm_volume_off"
                app:iconSize="18dp"
                app:iconTint="@color/brand_dark_on_surface" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          The media, then the words, then the time. `alarm_hero` takes the
          full content width and as much height as the buttons and text leave
          it (`layout_weight` with a 0dp height), so a tall portrait photo and
          a wide landscape frame both get the whole stage instead of being
          cropped into a fixed square. `maxHeight` keeps it from swallowing a
          tablet's whole screen.
        -->
        <FrameLayout
            android:id="@+id/alarm_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:background="@drawable/alarm_hero_fallback"
            android:clipToOutline="true"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/alarm_hero_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_notification"
                app:tint="@color/brand_dark_on_primary_container" />

            <!--
              `fitCenter`, not `centerCrop`: this is the user's own picture at
              the moment it is meant to come back to them, so it is shown
              whole. The dimmed full-bleed copy behind already fills whatever
              the aspect ratio leaves over.
            -->
            <ImageView
                android:id="@+id/alarm_hero_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/alarm_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/brand_dark_on_surface"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="Take evening medication" />

        <TextView
            android:id="@+id/alarm_media_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/brand_dark_on_surface_variant"
            android:textSize="17sp"
            tools:text="You promised yourself 20 minutes. Go." />

        <!--
          The clock, demoted. One line, under the words it belongs to, at the
          size of a caption: it is context for the moment, not the headline.
          `alarm_time_period` ("AM"/"PM") and `alarm_date` stay as separate
          views because `AlarmActivity` binds all three, but they now read as
          one quiet line.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/alarm_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/brand_dark_primary"
                android:textSize="20sp"
                tools:text="7:30" />

            <TextView
                android:id="@+id/alarm_time_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/brand_dark_primary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="AM"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/alarm_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/brand_dark_on_surface_variant"
                android:textSize="14sp"
                tools:text="Thursday, 25 September" />
        </LinearLayout>

        <!--
          Kept in the tree but never shown: `AlarmActivity` still binds this
          id, and the recurrence rule is configuration nobody reads while an
          alarm is ringing. `GONE` with zero size costs nothing and avoids a
          binding change in the one class that must not crash at 7 AM.
        -->
        <TextView
            android:id="@+id/alarm_repeat_summary"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:ignore="SmallSp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- Actions: Play is the answer the alarm is asking for, so it is the biggest target. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_accept_button"
            style="@style/AlarmAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_accept"
            app:icon="@drawable/ic_alarm_play" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_snooze_button"
                style="@style/AlarmAction.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/alarm_snooze"
                app:icon="@drawable/ic_alarm_snooze" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_dismiss_button"
                style="@style/AlarmAction.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/alarm_dismiss"
                app:icon="@drawable/ic_alarm_close" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
