<?xml version="1.0" encoding="utf-8"?>
<!--
  MR-06 "Full-screen alarm activity". Reads top to bottom the way a person
  wakes to it: what time it is, what this is for, then what to do about it.

  Always dark (Theme.AppTheme.Alarm) and colored from the native brand
  mirror in res/values/colors.xml, so it looks like the rest of Nudgio rather
  than a stock system alarm. Plain Views + Material components; no Compose
  dependency exists in this project.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_dark_surface">

    <!-- The reminder's own artwork, full-bleed and dimmed, so the alarm looks like the thing it is about. Decorative. -->
    <ImageView
        android:id="@+id/alarm_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/alarm_background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/alarm_scrim_gradient"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/alarm_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <!-- Brand + sound control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notification"
                app:tint="@color/brand_dark_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/brand_dark_on_surface_variant"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_silence_button"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:text="@string/alarm_silence_sound"
                android:textColor="@color/brand_dark_on_surface"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_alarm_volume_off"
                app:iconSize="18dp"
                app:iconTint="@color/brand_dark_on_surface" />
        </LinearLayout>

        <!-- Clock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/alarm_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:textColor="@color/brand_dark_on_surface"
                    android:textSize="80sp"
                    tools:text="7:30" />

                <TextView
                    android:id="@+id/alarm_time_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/brand_dark_on_surface_variant"
                    android:textSize="22sp"
                    android:visibility="gone"
                    tools:text="AM"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/alarm_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/brand_dark_on_surface_variant"
                android:textSize="16sp"
                tools:text="Thursday, 25 September" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- What this reminder is about -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/alarm_hero"
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:background="@drawable/alarm_hero_fallback"
                android:clipToOutline="true"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/alarm_hero_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/brand_dark_on_primary_container" />

                <ImageView
                    android:id="@+id/alarm_hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/alarm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:textColor="@color/brand_dark_on_surface"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="Take evening medication" />

            <TextView
                android:id="@+id/alarm_media_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/brand_dark_on_surface_variant"
                android:textSize="16sp"
                tools:text="Dosage reminder video" />

            <TextView
                android:id="@+id/alarm_repeat_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/alarm_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="@color/brand_dark_on_surface"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Every day at 8:00 PM"
                tools:visibility="visible" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Actions: Play is the answer the alarm is asking for, so it is the biggest target. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_accept_button"
            style="@style/AlarmAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_accept"
            app:icon="@drawable/ic_alarm_play" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_snooze_button"
                style="@style/AlarmAction.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/alarm_snooze"
                app:icon="@drawable/ic_alarm_snooze" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_dismiss_button"
                style="@style/AlarmAction.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/alarm_dismiss"
                app:icon="@drawable/ic_alarm_close" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
