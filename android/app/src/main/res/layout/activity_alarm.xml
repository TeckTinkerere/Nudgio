<?xml version="1.0" encoding="utf-8"?>
<!--
  MR-06 "Full-screen alarm activity": static reminder context plus native
  Play/Snooze/Dismiss controls (here labeled Accept/Snooze/Dismiss per the
  presentation request — Accept resolves the same way "Play" does everywhere
  else in the bridge/notification contract, see AlarmActivity's doc comment).
  Plain Views, not Compose (no Compose dependency exists in this project) —
  Material components only, matching styles.xml's Theme.Material3 parent.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!--
      The selected media's own thumbnail, behind everything, at low opacity:
      the alarm should look like the thing it is reminding you of. Set from
      AlarmActivity only when the reminder actually resolves to a thumbnail
      on disk; it stays GONE otherwise, so the flat #121212 above remains
      the fallback rather than a broken/empty image well. Not focusable and
      marked decorative — the label/media-title text already carries the
      same meaning for TalkBack.
    -->
    <ImageView
        android:id="@+id/alarm_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.28"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!--
      Scrim over the artwork so the white body text keeps its contrast
      regardless of how bright the underlying frame is (MR-13 ACC contrast
      floor) — without it a light thumbnail makes the buttons unreadable.
    -->
    <View
        android:id="@+id/alarm_background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/alarm_overflow_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/alarm_more_options"
            android:src="@drawable/ic_more_vert" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <TextView
            android:id="@+id/alarm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="Take evening medication" />

        <TextView
            android:id="@+id/alarm_media_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCFFFFFF"
            android:textSize="18sp"
            tools:text="Dosage reminder video" />

        <TextView
            android:id="@+id/alarm_repeat_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            tools:text="Every day at 8:00 PM" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_accept_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/alarm_accept"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_snooze_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/alarm_snooze"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_dismiss_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/alarm_dismiss"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

</FrameLayout>
