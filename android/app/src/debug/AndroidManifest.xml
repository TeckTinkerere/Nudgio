<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG SOURCE SET ONLY — this file is not part of a release build, so nothing
  it declares reaches a shipped APK.

  ADR-015 says the *production* manifest has no INTERNET permission, and
  src/main/AndroidManifest.xml honours that (verify with
  `./gradlew :app:processReleaseManifest` and read the merged output). The
  Flutter tool's hot reload and DevTools talk to the debug engine over a
  loopback socket forwarded by adb: a dev-tooling need, not a product
  capability. Release builds are AOT-compiled and open no socket.

  (Under React Native the same permission let the debug build reach Metro.)

  MR-18's "a permission arrives with the receiver/service/ADR that needs it"
  is satisfied here by scope rather than by a new ADR: the permission is
  confined to the debug variant and paired with a network security config that
  only whitelists loopback. Logged in docs/decision-log.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Flutter hot reload / DevTools over adb-forwarded loopback. Debug only. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
