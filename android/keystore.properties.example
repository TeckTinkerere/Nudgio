# Copy to `keystore.properties` (already gitignored) for local/offline
# release signing (MR-20: "local/offline signing is acceptable for early
# releases"). CI should prefer the RELEASE_STORE_FILE / RELEASE_STORE_PASSWORD
# / RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD environment variables instead -
# see scripts/release/README.md. Never commit a real keystore.properties or
# .keystore/.jks file (MR-20: "Never paste key password or keystore into an
# AI chat, issue, commit or public CI variable output").

storeFile=release.keystore
storePassword=changeme
keyAlias=nudgio-release
keyPassword=changeme

